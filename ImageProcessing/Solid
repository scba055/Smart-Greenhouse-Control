import cv2
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

def isolate_leaves_kmeans(image_path, output_path, k):
    # Load image
    img = cv2.imread(image_path)
    if img is None:
        raise ValueError("Could not load image at " + image_path)

    # Convert to HSV
    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

    # Flatten image into (num_pixels, 3) for clustering
    pixels = hsv.reshape(-1, 3)

    # Run KMeans clustering
    kmeans = KMeans(n_clusters=k, random_state=42, n_init="auto")
    kmeans.fit(pixels)
    labels = kmeans.labels_
    centers = kmeans.cluster_centers_

    # Identify cluster closest to green hue
    # Green hue is roughly around 35–95 in HSV
    green_hue_range = (35, 95)

    cluster_hues = centers[:, 0]  # just the hue channel
    distances = []
    for hue in cluster_hues:
        if green_hue_range[0] <= hue <= green_hue_range[1]:
            distances.append(0)  # ideal match
        else:
            # distance to nearest bound of green range
            distances.append(min(abs(hue - green_hue_range[0]),
                                 abs(hue - green_hue_range[1])))

    leaf_cluster_idx = int(np.argmin(distances))

    # Build mask where pixels belong to that cluster
    mask = (labels.reshape(hsv.shape[:2]) == leaf_cluster_idx).astype("uint8") * 255

    # Morphological cleanup
    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    # Apply mask to original image
    leaves_only = cv2.bitwise_and(img, img, mask=mask)

    # Save result
    cv2.imwrite(output_path, leaves_only)

    # Display results
    plt.figure(figsize=(15, 7))
    plt.subplot(1, 3, 1)
    plt.title("Original")
    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.title("Mask from KMeans")
    plt.imshow(mask, cmap="gray")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.title("Leaves Only")
    plt.imshow(cv2.cvtColor(leaves_only, cv2.COLOR_BGR2RGB))
    plt.axis("off")

    plt.show()

# Example usage:
isolate_leaves_kmeans("ImageProcessing\picture_2025_09_09-16_30_00.JPEG", "ImageProcessing\leaves_only.png", k=5)