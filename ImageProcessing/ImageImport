import cv2
import numpy as np
import matplotlib.pyplot as plt

def contour_plants(image_path, output_path):
    # Load image
    img = cv2.imread(image_path)
    if img is None:
        raise ValueError("Could not load image at " + image_path)

    # Convert to grayscale
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # --- EDIT STARTS HERE ---

    # Adaptive thresholding (instead of Canny)
    thresh = cv2.adaptiveThreshold(
        gray, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY,
        11, 2
    )

    # Morphological cleanup
    kernel = np.ones((3,3), np.uint8)
    thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel)
    thresh = cv2.dilate(thresh, kernel, iterations=1)

    # Find contours from thresholded image
    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    # --- EDIT ENDS HERE ---

    # Draw contours on copy of original
    contoured = img.copy()
    cv2.drawContours(contoured, contours, -1, (0, 255, 0), 3)  # thicker lines

    # Save result
    cv2.imwrite(output_path, contoured)

    # Display side by side
    # plt.figure(figsize=(15,7))
    # plt.subplot(1,3,1)
    # plt.title("Original")
    # plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    # plt.axis("off")

    # plt.subplot(1,3,2)
    plt.title("Thresholded")
    plt.imshow(thresh, cmap='gray')
    plt.axis("off")

    # plt.subplot(1,3,3)
    # plt.title("Contours")
    # plt.imshow(cv2.cvtColor(contoured, cv2.COLOR_BGR2RGB))
    # plt.axis("off")

    plt.show()


# Example usage
contour_plants("ImageProcessing\picture_2025_09_09-16_30_00.JPEG", "ImageProcessing\plant_contours.png")